{
  "name": "ai-model-verifier",
  "version": "1.4.0",
  "description": "Verify an AI API endpoint really serves the model it claims: model substitution, Claude thinking signatures, token-billing accuracy, response-envelope and throughput evidence.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unorouter/ai-model-verifier.git"
  },
  "keywords": [
    "ai",
    "llm",
    "relay",
    "proxy",
    "verify",
    "authenticity",
    "model-verification",
    "fake-model",
    "anthropic",
    "claude",
    "openai",
    "gemini",
    "token-billing"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "default": "./dist/providers/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/unorouter/ai-model-verifier",
  "bugs": {
    "url": "https://github.com/unorouter/ai-model-verifier/issues"
  }
}
